{
  "name": "da-websiet-video",
  "version": "1.0.0",
  "private": true,
  "main": "main-electron.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "app": "node run-electron.js",
    "dist": "node build-installer.js",
    "selftest-upload": "node server.js --selftest-upload"
  },
  "build": {
    "appId": "com.tiktube.desktop",
    "productName": "TIKTUBE",
    "copyright": "Copyright © 2026 TIKTUBE PTK",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TIKTUBE"
    },
    "files": [
      "main-electron.js",
      "index.html",
      "video.html",
      "upload.html",
      "user.html",
      "history.html",
      "subscriptions.html",
      "login.html",
      "style.css",
      "script.js",
      "config.js",
      "pwa.js",
      "manifest.json",
      "icon.ico",
      "icon-192.png",
      "icon-512.png",
      "icon.svg"
    ]
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ffprobe-static": "^3.1.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.2.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
}
